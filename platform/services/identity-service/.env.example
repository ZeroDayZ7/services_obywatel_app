# ==============================================================================
# Application & HTTP Server Configuration (net/http)
# ==============================================================================
APP_NAME=identity_service
APP_VERSION=0.1.0
ENV=development

PORT=8087
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# Key Management Service (KMS Integration)
# ==============================================================================
KMS_ENDPOINT=http://127.0.0.1:8081
KMS_SERVICE_NAME=identity-service
KMS_SERVICE_SECRET=super-long-random-secret-for-identity-service-hmac-64-bytes
KMS_TIMEOUT=2s

# ==============================================================================
# Database Configuration (PostgreSQL / pgxpool)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5437
DB_USER=identity_user
DB_PASSWORD=admin
DB_NAME=identity_database
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ==============================================================================
# Cache & Messaging
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# ==============================================================================
# STORAGE (S3 / MinIO)
# ==============================================================================
S3_ENABLED=true
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=citizens-data
S3_REGION=us-east-1
S3_USE_SSL=false

# ==============================================================================
# Audit Worker Configuration
# ==============================================================================
AUDIT_WORKER_ENABLED=false
AUDIT_WORKER_BATCH_SIZE=200
AUDIT_WORKER_INTERVAL=2s
AUDIT_WORKER_MAX_RETRIES=10
AUDIT_WORKER_BACKOFF_BASE=1s
AUDIT_WORKER_BACKOFF_MAX=60s
AUDIT_WORKER_CONCURRENCY=1
AUDIT_WORKER_ROUTING_KEY=audit.events
AUDIT_WORKER_SOURCE_SERVICE=identity-service

# ==============================================================================
# Registration Worker Configuration
# ==============================================================================
REGISTRATION_WORKER_ENABLED=false
REGISTRATION_WORKER_BATCH_SIZE=100
REGISTRATION_WORKER_INTERVAL=2s
REGISTRATION_WORKER_MAX_RETRIES=5
REGISTRATION_WORKER_BACKOFF_BASE=1s
REGISTRATION_WORKER_BACKOFF_MAX=30s
REGISTRATION_WORKER_CONCURRENCY=2
REGISTRATION_WORKER_ROUTING_KEY=auth.register

# ==============================================================================
# OpenTelemetry (OTEL)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
OTEL_SERVICE_NAME=citizen-service