# ==============================================================================
# Application & HTTP Server Configuration (net/http)
# ==============================================================================
APP_NAME=citizen-service
APP_VERSION=0.1.0
ENV=development

PORT=8083
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# Internal Security & HMAC (Gateway <-> Citizen-Service)
# ==============================================================================
INTERNAL_SERVICE_ID=citizen-service
# Secret HMAC (minimum 32-64 bajty Hex)
INTERNAL_HMAC_SECRET=your_long_64_byte_hex_hmac_secret_here
PESEL_SALT=your_pesel_salt_string_min_16_chars

# ==============================================================================
# Key Management Service (KMS Integration)
# ==============================================================================
KMS_ENDPOINT=http://kms-service:8080
KMS_SERVICE_SECRET=your_kms_exchange_hmac_secret_here

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=citizen_db
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ==============================================================================
# Cache & Messaging
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ==============================================================================
# OpenTelemetry (OTEL)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=citizen-service