# ==============================================================================
# Application & HTTP Server Configuration (net/http)
# ==============================================================================
APP_NAME=identity_service
APP_VERSION=0.1.0
ENV=development

PORT=8087
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# Key Management Service (KMS Integration)
# ==============================================================================
KMS_ENDPOINT=http://127.0.0.1:8081
# Sekret HMAC służący do autoryzacji i wymiany kluczy DEK/KEK z KMS
KMS_SERVICE_SECRET=super-long-random-secret-for-identity-service-hmac-64-bytes
KMS_TIMEOUT=2s

# ==============================================================================
# Database Configuration (PostgreSQL / pgxpool)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5437
DB_USER=identity_user
DB_PASSWORD=admin
DB_NAME=identity_database
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ==============================================================================
# Cache & Messaging
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# ==============================================================================
# OpenTelemetry (OTEL)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
OTEL_SERVICE_NAME=citizen-service