# ==============================================================================
# AUTH-SERVICE - MAIN CONFIGURATION
# ==============================================================================

# Server
APP_NAME=auth-service
PORT=8082
APP_ENV=development
APP_VERSION=0.1.0
SERVER_HEADER=ZeroDayZ7
PREFORK=false
CASE_SENSITIVE=true
STRICT_ROUTING=false

# Czas trwania (Duration)
IDLE_TIMEOUT=30s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s

# Graceful shutdown
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# KMS (KEY MANAGEMENT SERVICE) & SECRET AGENT (UDS SIDEKAR)
# ==============================================================================
KMS_ENDPOINT=http://kms-service:8080
KMS_SERVICE_NAME=auth-service
KMS_SERVICE_SECRET=super-long-random-secret-for-auth-service-hmac-64-bytes
KMS_TIMEOUT=2s

SECRET_AGENT_SOCKET_PATH=/var/run/agent-sockets/agent.sock

# ==============================================================================
# SECURITY & AUTH
# ==============================================================================
AUTH_DOMAIN=obywatel.gov.pl
# Tryb podpisywania JWT: "local" (podpisywanie w pamięci serwisu) lub "kms" (podpisywanie zdalne przez API KMS)
JWT_SIGNING_MODE=kms
# JWT Refresh (Secret dla tokenów odświeżających)
JWT_REFRESH_SECRET=super_refresh_secret_123

# TTL dla JWT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h  # 7 dni

# Sessions
SESSION_TTL=60m

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================

DB_HOST=db-auth
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=admin
DB_NAME=auth_database
DB_SSLMODE=disable

# Connection Pool
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ==============================================================================
# INFRASTRUCTURE
# ==============================================================================

# Redis Connection
REDIS_HOST=cache-redis
REDIS_PORT=6379
REDIS_PASSWORD=admin
REDIS_DB=0

# Redis Pool & Timeouts
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_POOL_TIMEOUT=4s
REDIS_TIMEOUT=5s

# Sessions
REDIS_SESSION_PREFIX=session:
REDIS_SESSION_TTL=60m

# ==============================================================================
# Telemetry
# ==============================================================================
OTEL_ENABLED=false
OTEL_ENDPOINT=localhost:4318
OTEL_SERVICE_NAME=auth

# ==============================================================================
# INFRASTRUCTURE (RabbitMQ)
# ==============================================================================
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/