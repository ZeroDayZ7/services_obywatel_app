# ==============================================================================
# Application & HTTP Server Configuration
# ==============================================================================
APP_NAME=messaging-service
APP_VERSION=0.1.0
ENV=development

PORT=8086
SERVER_HEADER=ZeroDayZ7
PREFORK=false
CASE_SENSITIVE=true
STRICT_ROUTING=false

IDLE_TIMEOUT_SEC=30
READ_TIMEOUT_SEC=15
WRITE_TIMEOUT_SEC=15
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# KMS (KEY MANAGEMENT SERVICE)
# ==============================================================================
KMS_ENDPOINT=http://127.0.0.1:8080
KMS_INTERNAL_SECRET=super-long-random-secret-for-messaging-service-hmac-64-bytes

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5436
DB_USER=messaging_user
DB_PASSWORD=admin
DB_NAME=messaging_db
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60