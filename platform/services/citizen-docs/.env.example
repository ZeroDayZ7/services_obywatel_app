# ==============================================================================
# Application & HTTP Server Configuration
# ==============================================================================
APP_NAME=citizen-docs-service
APP_VERSION=0.1.0
APP_ENV=development

PORT=8083
SERVER_HEADER=ZeroDayZ7
PREFORK=false
CASE_SENSITIVE=true
STRICT_ROUTING=false

IDLE_TIMEOUT_SEC=30
READ_TIMEOUT_SEC=15
WRITE_TIMEOUT_SEC=15

SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=citizen_user
DB_PASSWORD=admin
DB_NAME=citizen_database
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30

# ==============================================================================
# KMS (KEY MANAGEMENT SERVICE)
# ==============================================================================
KMS_ENDPOINT=http://127.0.0.1:8080
KMS_INTERNAL_SECRET=super-long-random-secret-for-docs-service-hmac-64-bytes

# ==============================================================================
# Security & Internal Service Encryption
# ==============================================================================
# Dedykowana sól HMAC do PESEL-i w serwisie citizen-docs (min 16 znaków)
DOCS_PESEL_SALT=p@ssw0rd_S@lt_Very_Str0ng_123!

# UWAGA:
# - INTERNAL_HMAC_SECRET jest pobierany z KMS przy starcie
# - Szyfrowanie bazy bazuje na KMS Envelope Encryption (brak statycznego klucza AES w .env)

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60