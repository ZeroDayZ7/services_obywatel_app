# ==============================================================================
# GATEWAY - MAIN CONFIGURATION
# ==============================================================================

# Server
APP_NAME=gateway_service
PORT=8090
APP_ENV=development
APP_VERSION=2.1.1
BODY_LIMIT_MB=2
SERVER_HEADER=ZeroDayZ7/Gateway
PREFORK=false
CASE_SENSITIVE=true
STRICT_ROUTING=false
IDLE_TIMEOUT=30s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# KMS (KEY MANAGEMENT SERVICE)
# ==============================================================================
KMS_ENDPOINT=http://kms-service:8080
KMS_SERVICE_NAME=gateway-service
KMS_SERVICE_SECRET=super-long-random-secret-for-gateway-service-hmac-64-bytes
KMS_TIMEOUT=2s

# ==============================================================================
# SECURITY & AUTH
# ==============================================================================
# UWAGA: 
# - JWT Access Public Key jest pobierany dynamicznie z KMS (z usługi 'auth-service')
# - INTERNAL_HMAC_SECRET jest pobierany z KMS przy starcie ('internal-communication-hmac')

CORS_ALLOW_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# ==============================================================================
# INFRASTRUCTURE
# ==============================================================================

# Redis Connection
REDIS_HOST=cache-redis
REDIS_PORT=6379
REDIS_PASSWORD=admin
REDIS_DB=0

# Redis Pool & Timeouts
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_POOL_TIMEOUT=4s
REDIS_TIMEOUT=5s

# Sessions
REDIS_SESSION_PREFIX=session:
REDIS_SESSION_TTL=60m

# ==============================================================================
# Telemetry
# ==============================================================================
OTEL_ENABLED=false
OTEL_ENDPOINT=localhost:4318
OTEL_SERVICE_NAME=gateway

# ==============================================================================
# UPSTREAM SERVICES
# ==============================================================================
SERVICE_AUTH_URL=http://auth-service:8082
SERVICE_DOCS_URL=http://localhost:8083
SERVICE_NOTIFY_URL=http://localhost:8084
SERVICE_IDENTITY_URL=http://localhost:8087
SERVICE_MESSAGING_URL=http://localhost:8086
SERVICE_OFFICER_BFF_URL=http://localhost:8088


SERVICE_WS_URL=ws://localhost:8084

# ==============================================================================
# PROXY TUNING
# ==============================================================================

PROXY_MAX_IDLE_CONNS=100
PROXY_MAX_IDLE_CONNS_PER_HOST=20

PROXY_IDLE_CONN_TIMEOUT=90s
PROXY_REQUEST_TIMEOUT=30s


# ==============================================================================
# INFRASTRUCTURE (RabbitMQ)
# ==============================================================================
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/