PORT=8092
APP_ENV=development
APP_VERSION=1.0.0
APP_NAME=websocket-service
SERVER_HEADER=ZeroDayZ7
BODY_LIMIT_MB=2
PREFORK=false
CASE_SENSITIVE=true
STRICT_ROUTING=false
IDLE_TIMEOUT=30s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

REDIS_HOST=cache-redis
REDIS_PORT=6379
REDIS_USERNAME=redis_kms_admin
REDIS_PASSWORD=redis_kms_admin_secret
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_POOL_TIMEOUT=4s
REDIS_TIMEOUT=5s

SHARED_SECRET=dev-shared-secret
INTERNAL_BROADCAST_KEY=dev-internal-broadcast-key
