{
  "version": "1.0",
  "description": "KMS Seed Credentials Config for Obywatel App Services",
  "services": [
    {
      "service_name": "kms-system",
      "description": "Credentials for KMS system administration and database",
      "credentials": [
        {
          "key": "KMS_ADMIN_USER",
          "value": "kms_admin",
          "target": "db-auth"
        },
        {
          "key": "KMS_ADMIN_PASSWORD",
          "value": "",
          "target": "db-auth",
          "source_secret_file": "./secrets/.kms_admin_auth_pass"
        }
      ]
    },
    {
      "service_name": "auth-service",
      "description": "Authentication service credentials and databases",
      "credentials": [
        {
          "key": "DB_USER",
          "value": "auth_db_root",
          "target": "db-auth"
        },
        {
          "key": "DB_PASSWORD",
          "value": "",
          "target": "db-auth",
          "source_secret_file": "./secrets/.auth_db_password"
        },
        {
          "key": "DB_NAME",
          "value": "auth_database",
          "target": "db-auth"
        },
        {
          "key": "DB_HOST",
          "value": "db-auth",
          "target": "db-auth"
        },
        {
          "key": "DB_PORT",
          "value": "5432",
          "target": "db-auth"
        }
      ]
    },
    {
      "service_name": "shared-infrastructure",
      "description": "Shared cache, message broker, and object storage credentials",
      "credentials": [
        {
          "key": "REDIS_PASSWORD",
          "value": "",
          "target": "cache-redis",
          "source_secret_file": "./secrets/.redis_password"
        },
        {
          "key": "RABBITMQ_DEFAULT_USER",
          "value": "",
          "target": "rabbitmq",
          "source_secret_file": "./secrets/.rabbitmq_user"
        },
        {
          "key": "RABBITMQ_DEFAULT_PASS",
          "value": "",
          "target": "rabbitmq",
          "source_secret_file": "./secrets/.rabbitmq_password"
        },
        {
          "key": "MINIO_ROOT_USER",
          "value": "",
          "target": "minio",
          "source_secret_file": "./secrets/.minio_user"
        },
        {
          "key": "MINIO_ROOT_PASSWORD",
          "value": "",
          "target": "minio",
          "source_secret_file": "./secrets/.minio_password"
        }
      ]
    }
  ]
}
