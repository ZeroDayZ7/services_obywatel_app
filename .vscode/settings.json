{
  // (Explorer)
  "files.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    // "**/go.mod": true,
    "**/.gitattributes": true,
    "**/.github": true,
    "**/.gitignore": true,
    "**/bin/": true,
    // "**/dbgen/": true,
    "**/backup/": true,
    "platform/templates/": true,
    // "**/.env*": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,

    "**/.dockerignore": true,
    "**/Dockerfile": true,

    "**/admin-bff": true,
    "**/audit-service": true,
    "**/citizen-docs": true,
    "**/delegation-service": true,
    "**/messaging-service": true,
    "**/notification-service": true,
    "**/tally-service": true,
    "**/version-service": true,
    "**/voting-service": true,

    "**/*.bkp": true,
    "**/tmp": true
  },

  // (Search)
  "search.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    // "**/go.mod": true,
    "**/logs/": true,
    "**/bin/": true,
    "**/backup/": true,
    "**/templates/": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/Dockerfile": true,
    "**/.dockerignore": true,
    "**/obywatel-app.code-workspace": true
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "go.formatTool": "gofumpt",
  "go.lintTool": "golangci-lint",
  "evenBetterToml.schema.enabled": false,
  "go.lintOnSave": "package",
  "editor.rulers": [120, 150],
  "gopls": {
    "ui.diagnostic.staticcheck": false,
    "ui.navigation.importShortcut": "Definition",
    "formatting.gofumpt": false,
    "build.directoryFilters": [
      "-**/node_modules",
      "-**/.git",
      "-**/dist",
      "-**/bin",
      "-**/tmp",
      "-**/vendor",
      "-**/docker",
    ]
  },
  "go.vetOnSave": "off"
}
