{
  // (Explorer)
  "files.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    "**/go.mod": true,
    "**/logs/": true,
    "**/bin/": true,
    // "**/dbgen/": true,
    "**/backup/": true,
    "platform/templates/": true,
    "**/.env.example": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/.github": true,
    "**/.dockerignore": true,
    "**/Dockerfile": true,
    "**/obywatel-app.code-workspace": true,

    "**/admin-bff": true,
    "**/audit-service": true,
    // "**/citizen-docs": true,
    "**/delegation-service": true,
    // "**/messaging-service": true,
    "**/notification-service": true,
    "**/tally-service": true,
    "**/version-service": true,
    "**/voting-service": true,
  },

  // (Search)
  "search.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    // "**/go.mod": true,
    "**/logs/": true,
    "**/bin/": true,
    "**/backup/": true,
    "**/templates/": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/Dockerfile": true,
    "**/.dockerignore": true,
    "**/obywatel-app.code-workspace": true
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "go.formatTool": "gofumpt",
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "editor.rulers": [120, 150]
}
